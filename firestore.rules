rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidCardTheme(theme) {
      return theme is string
        && theme.size() >= 1
        && theme.size() <= 32
        && theme in ['classic', 'midnight-gold', 'neon-arcade', 'sakura-pastel', 'royal-ruby'];
    }

    function isValidTableTheme(theme) {
      return theme is string
        && theme.size() >= 1
        && theme.size() <= 32
        && theme in ['emerald', 'navy', 'bordeaux', 'obsidian'];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'coins',
          'unlockedCards',
          'unlockedTables',
          'equippedCard',
          'equippedTable',
          'gamesPlayed',
          'gamesWon',
          'currentStreak',
          'bestStreak',
          'highestRoundPoints',
          'lastDailyClaimAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'coins',
          'unlockedCards',
          'unlockedTables',
          'equippedCard',
          'equippedTable',
          'gamesPlayed',
          'gamesWon',
          'currentStreak',
          'bestStreak',
          'highestRoundPoints',
          'lastDailyClaimAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 24
        && data.coins is int
        && data.coins >= 0
        && data.coins <= 1000000
        && data.unlockedCards is list
        && data.unlockedCards.size() >= 1
        && data.unlockedCards.size() <= 10
        && data.unlockedCards[0] is string
        && data.unlockedCards.hasOnly(['classic', 'midnight-gold', 'neon-arcade', 'sakura-pastel', 'royal-ruby'])
        && data.unlockedTables is list
        && data.unlockedTables.size() >= 1
        && data.unlockedTables.size() <= 10
        && data.unlockedTables[0] is string
        && data.unlockedTables.hasOnly(['emerald', 'navy', 'bordeaux', 'obsidian'])
        && isValidCardTheme(data.equippedCard)
        && data.equippedCard in data.unlockedCards
        && isValidTableTheme(data.equippedTable)
        && data.equippedTable in data.unlockedTables
        && data.gamesPlayed is int
        && data.gamesPlayed >= 0
        && data.gamesWon is int
        && data.gamesWon >= 0
        && data.gamesWon <= data.gamesPlayed
        && data.currentStreak is int
        && data.currentStreak >= 0
        && data.bestStreak is int
        && data.bestStreak >= data.currentStreak
        && data.highestRoundPoints is int
        && data.highestRoundPoints >= 0
        && (data.lastDailyClaimAt is int || data.lastDailyClaimAt is float)
        && data.lastDailyClaimAt >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isInitialUserProfile(data) {
      return data.coins == 250
        && data.unlockedCards == ['classic']
        && data.unlockedTables == ['emerald']
        && data.equippedCard == 'classic'
        && data.equippedTable == 'emerald'
        && data.gamesPlayed == 0
        && data.gamesWon == 0
        && data.currentStreak == 0
        && data.bestStreak == 0
        && data.highestRoundPoints == 0
        && data.lastDailyClaimAt == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isEquipOrNameAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'displayName',
        'equippedCard',
        'equippedTable',
        'updatedAt'
      ]);
    }

    function isPurchaseAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'coins',
          'unlockedCards',
          'unlockedTables',
          'equippedCard',
          'equippedTable',
          'updatedAt'
        ])
        && incoming().coins < existing().coins
        && incoming().unlockedCards.size() >= existing().unlockedCards.size()
        && incoming().unlockedTables.size() >= existing().unlockedTables.size();
    }

    function isRewardOrDailyAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'coins',
          'gamesPlayed',
          'gamesWon',
          'currentStreak',
          'bestStreak',
          'highestRoundPoints',
          'lastDailyClaimAt',
          'updatedAt'
        ])
        && incoming().coins >= existing().coins
        && incoming().coins <= existing().coins + 350
        && incoming().gamesPlayed >= existing().gamesPlayed
        && incoming().gamesWon >= existing().gamesWon;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && isInitialUserProfile(incoming());
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isEquipOrNameAction() || isPurchaseAction() || isRewardOrDailyAction());
      allow delete: if false;
    }
  }
}
